# Copy this file to .env.local (which is gitignored) and fill in your own Supabase
# project's values from Project Settings -> API in the Supabase dashboard.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the public, client-safe key (Supabase's current name
# for what used to be called the "anon" key) — safe to ship in a frontend bundle.
# NEVER put the secret/service_role key or database password here or anywhere in this
# project.
#
# If these are left unset, DreamBloom falls back to local-only (localStorage) mode —
# npm run dev keeps working without a Supabase project.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
